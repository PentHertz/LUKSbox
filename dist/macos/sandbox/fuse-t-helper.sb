;; LUKSbox FUSE-T mount-helper sandbox profile (sandbox-exec).
;;
;; Restricts what the GUI-spawned `luksbox mount-fuse-t-helper`
;; subprocess (and the FUSE-T NFS server and mount tool it starts) can
;; do. Defense in depth against a future libfuse-t.dylib / go-nfsv4
;; vulnerability that tries to read other files, run a shell or reach
;; the network.
;;
;; Status: opt-in via `LUKSBOX_SANDBOX_HELPER=1` (GUI). Checked on
;; macOS 26 with FUSE-T 1.2.9: mount, file writes and reads through the
;; mount, unmount, with and without a detached header and an anchor.
;;
;; Parameters, passed by the GUI as `sandbox-exec -D NAME=value`
;; (canonical absolute paths):
;;   VAULT_DIR     parent directory of the .lbx file (or of the .lbxs
;;                 sync bundle folder)
;;   HEADER_DIR    parent directory of the detached header, or VAULT_DIR
;;   ANCHOR_DIR    parent directory of the rollback anchor, or VAULT_DIR
;;                 (the anchor is read at open and rewritten on saves)
;;   SYNC_DIR      a sync bundle: this device's sync state folder (the
;;                 session's lock, staged changes, identity, the folder
;;                 registry); VAULT_DIR otherwise
;;   MOUNTPOINT    the mountpoint directory itself
;;   BUNDLE_DIR    the directory holding the luksbox binary
;;   HELPER        the luksbox binary itself (the only one exec'd here)
;;
;; Profile syntax: the macOS sandbox profile language (TinyScheme
;; based); /System/Library/Sandbox/Profiles/ has Apple's own examples.

(version 1)
(deny default)

;; dyld, libSystem and the basic services every process needs.
(import "system.sb")

;; Path resolution (lstat / realpath on the way to the vault) anywhere;
;; contents stay denied unless listed below.
(allow file-read-metadata)

(allow file-read*
    (subpath "/usr/lib")
    (subpath "/usr/local/lib")
    (subpath "/opt/homebrew")
    (subpath "/System")
    (subpath "/Library/Application Support/fuse-t")
    (subpath "/Library/Frameworks")
    (subpath (param "BUNDLE_DIR"))
    (subpath (param "VAULT_DIR"))
    (subpath (param "HEADER_DIR"))
    (subpath (param "ANCHOR_DIR"))
    (subpath (param "SYNC_DIR"))
    ;; The mountpoint directory: probed, locked until the final save,
    ;; and mounted on. Not its parent.
    (literal (param "MOUNTPOINT"))
    (literal "/dev/null")
    (literal "/dev/random")
    (literal "/dev/urandom")
    (literal "/dev/stdin"))

;; Writes: the vault, its detached header, its anchor (all rewritten on
;; saves, each with temporary files next to it), a sync bundle's state
;; on this device, and the temporary folders FUSE-T uses for its sockets.
(allow file-write*
    (subpath (param "VAULT_DIR"))
    (subpath (param "HEADER_DIR"))
    (subpath (param "ANCHOR_DIR"))
    (subpath (param "SYNC_DIR"))
    (subpath "/private/tmp")
    (subpath "/private/var/folders")
    (literal "/dev/null")
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/dtracehelper"))

;; Network: the local NFS transport only, nothing else.
(allow network-bind (local ip "localhost:*") (local unix-socket))
(allow network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*") (remote unix-socket))
(allow system-socket)

;; The helper itself (sandbox-exec applies the profile before its exec),
;; FUSE-T's NFS server (go-nfsv4), started by libfuse-t, and the system
;; NFS mount / unmount tools. No shell, nothing else.
(allow process-fork)
(allow process-exec
    (literal (param "HELPER"))
    (subpath "/Library/Application Support/fuse-t/bin")
    (literal "/sbin/mount")
    (literal "/sbin/mount_nfs")
    (literal "/sbin/umount"))
(allow signal (target self) (target children))
(allow process-info* (target self) (target children))

;; Attaching the NFS file system to the mountpoint.
(allow file-mount file-unmount (literal (param "MOUNTPOINT")))
(allow system-fsctl)
(allow sysctl-read)

(allow mach-lookup
    (global-name "com.apple.system.notification_center")
    (global-name "com.apple.system.logger")
    (global-name "com.apple.SystemConfiguration.configd")
    (global-name "com.apple.SystemConfiguration.DNSConfiguration")
    (global-name "com.apple.dnssd.service")
    (global-name "com.apple.coreservices.launchservicesd")
    (global-name "com.apple.FileCoordination")
    (global-name "com.apple.DiskArbitration.diskarbitrationd")
    (global-name "com.apple.revisiond")
    (regex #"^org\.fuse-t\.")
    (regex #"^io\.macos-fuse-t\."))

;; Deliberately NOT allowed: the network beyond localhost, reading the
;; rest of the home folder, Keychains or other apps' preferences, writing
;; anywhere else, running a shell, loading kernel extensions.
